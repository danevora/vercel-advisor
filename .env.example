# --- Model access ---

# Vercel AI Gateway — all model calls route through here for unified billing,
# caching, and provider failover. Supports openai/*, anthropic/*, google/* etc.
AI_GATEWAY_API_KEY=

# Override the default model (gateway-style provider/model-id).
# Users can also switch models in the UI at runtime.
# ADVISOR_MODEL=openai/gpt-4o-mini

# --- GitHub (optional but recommended) ---
# Unauthenticated GitHub API has a 60 req/hr limit. Set a PAT to bump to 5000.
# Only needs `public_repo` scope.
GITHUB_TOKEN=

# --- Vercel Blob (needed to persist reports) ---
# Set automatically when you connect a Blob store to your Vercel project.
BLOB_READ_WRITE_TOKEN=
