# --- Model access (choose one path) ---

# Option A: Vercel AI Gateway (recommended for prod)
# When set, model strings like 'openai/gpt-4o-mini' route through the Gateway
# for unified billing, caching, and provider failover.
AI_GATEWAY_API_KEY=

# Option B: Direct provider keys (fallback when AI Gateway is not configured)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Override the default model (gateway-style id)
# ADVISOR_MODEL=openai/gpt-4o-mini

# --- GitHub (optional but recommended) ---
# Unauthenticated GitHub API has a 60 req/hr limit. Set a PAT to bump to 5000.
# Only needs `public_repo` scope.
GITHUB_TOKEN=

# --- Vercel Blob (needed to persist reports) ---
# Set automatically when you connect a Blob store to your Vercel project.
BLOB_READ_WRITE_TOKEN=
